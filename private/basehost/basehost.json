{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": ["../libSystem", "../", "./", "../../public/frameworks"],
  "sources_path": ["src/*.cpp", "src/*.S"],
  "output_name": "basehost.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17",
    "-L../libSystem",
    "-lSystem"
  ],
  "cpp_macros": [
      "kLaunchHostVersion=0x0200",
      "kLaunchHostVersionHighest=0x0200",
      "kLaunchHostVersionLowest=0x0200"
  ],
  "description": "Ne.app Base Process Host for User programs."
}
