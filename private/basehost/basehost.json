{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": ["../", "./", "../../public/frameworks"],
  "sources_path": ["src/*.cpp", "src/*.S"],
  "output_name": "basesvc.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
      "kLaunchHostVersion=0x0200",
      "kLaunchHostVersionHighest=0x0200",
      "kLaunchHostVersionLowest=0x0200"
  ],
  "description": "NeKernel Base Process Host."
}
