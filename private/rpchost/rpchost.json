{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": ["../", "./", "../../public/frameworks"],
  "sources_path": ["src/*.cpp", "src/*.S"],
  "output_name": "rpcsvc.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
      "kRPCHostVersion=0x0200",
      "kRPCHostVersionHighest=0x0200",
      "kRPCHostVersionLowest=0x0200"
  ],
  "description": "NeKernel RPC Process Host for OpenMSG."
}
