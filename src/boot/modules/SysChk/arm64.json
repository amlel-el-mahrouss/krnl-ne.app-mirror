{
  "compiler_path": "clang++",
  "compiler_std": "c++20",
  "headers_path": ["../", "../../", "../../../kernel", "../../../", "./"],
  "sources_path": ["*.cpp", "*.S", "../../src/HEL/ARM64/*.cpp", "../../src/HEL/ARM64/*.S", "../../src/*.cpp"],
  "output_name": "chk.efi",
  "compiler_flags": [
    "-ffreestanding",
    "-nostdlib",
    "-std=c++20",
    "-fno-rtti",
    "-fno-exceptions",
    "-fuse-ld=lld",
    "-Wl,-subsystem:efi_application,-entry:BootloaderMain",
    "-target aarch64-unknown-windows"
  ],
  "cpp_macros": [
    "__NEOSKRNL__",
    "__BOOTZ__",
    "__BOOTZ_STANDALONE__",
    "__NE_ARM64__",
    "kChkVersionHighest=0x0100",
    "kChkVersionLowest=0x0100",
    "kChkVersion=0x0100"
  ]
}
