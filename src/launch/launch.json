{
  "compiler_path": "x86_64-w64-mingw32-g++",
  "compiler_std": "c++20",
  "headers_path": ["../", "./", "../../public/frameworks"],
  "sources_path": ["src/*.cpp", "src/*.S"],
  "output_name": "launch.exe",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fPIC",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
      "kNeLaunchVersion=0x0100",
      "kNeLaunchVersionHighest=0x0100",
      "kNeLaunchVersionLowest=0x0100"
  ]
}
