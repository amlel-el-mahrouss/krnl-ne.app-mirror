{
  "compiler_path": "x86_64-w64-mingw32-gcc",
  "compiler_std": "c++20",
  "headers_path": ["../", "./"],
  "sources_path": ["src/*.cpp"],
  "output_name": "libASN.dll",
  "compiler_flags": [
    "-ffreestanding",
    "-shared",
    "-fno-rtti",
    "-fno-exceptions",
    "-Wl,--subsystem=17"
  ],
  "cpp_macros": [
    "__NEOSKRNL__",
    "__ASN_AMD64__",
    "__ASN__",
    "kASNVersionHighest=0x0100",
    "kASNVersionLowest=0x0100",
    "kASNVersion=0x0100"
  ],
  "description": "Audio Subsystem for NeKernel—handle multimedia requests."
}
